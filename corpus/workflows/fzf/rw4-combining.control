{
    "version":  2,
    "name":  "RW4 combining candidate under declared locale",
    "command":  [
                    "../../../.trial-private/corpus-tools/fzf",
                    "--height=10",
                    "--layout=reverse",
                    "--border",
                    "--prompt=Find: ",
                    "--walker=file",
                    "--walker-root=walker-root",
                    "--no-sort",
                    "--bind=start:reload(type candidates.txt)",
                    "--sync"
                ],
    "workspace":  {
                      "fixture":  "locale-fixture",
                      "cwd":  ".",
                      "home":  "temporary",
                      "temp":  "temporary"
                  },
    "width":  60,
    "height":  12,
    "timeout_ms":  15000,
    "run_timeout_ms":  30000,
    "max_output_bytes":  1000000,
    "steps":  [
                  {
                      "expect":  "5/5"
                  },
                  {
                      "text":  "cafe"
                  },
                  {
                      "expect":  "Find: cafe"
                  },
                  {
                      "expect":  "café-record.txt"
                  },
                  {
                      "key":  "Enter"
                  },
                  {
                      "exit":  0
                  },
                  {
                      "snapshot":  "rw4-combining.txt"
                  }
              ],
    "env":  {
                "LANG":  "C.UTF-8",
                "LC_ALL":  "C.UTF-8"
            }
}