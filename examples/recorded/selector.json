{
  "version": 2,
  "name": "Recorded selector",
  "command": [
    "../../bin/fixture",
    "gum"
  ],
  "workspace": {
    "fixture": "fixtures/selector",
    "cwd": ".",
    "home": "temporary",
    "temp": "temporary"
  },
  "inherit_env": [
    "PLAYTESTR_DELAY_MS",
    "PLAYTESTR_GUM"
  ],
  "width": 80,
  "height": 24,
  "timeout_ms": 15000,
  "run_timeout_ms": 60000,
  "max_output_bytes": 2000000,
  "steps": [
    {
      "expect": "Pick deployment"
    },
    {
      "key": "ArrowDown"
    },
    {
      "key": "Enter"
    },
    {
      "exit": 0
    },
    {
      "expect": "Beta"
    },
    {
      "snapshot": "recorded-gum-beta.txt"
    }
  ]
}
